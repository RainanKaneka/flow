{
  "name": "flow",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase-auth": "node scripts/build-firebase-auth.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emulators:start": "npx firebase-tools emulators:start",
    "emulators:export": "npx firebase-tools emulators:export ./firebase-emulator-data",
    "emulators:import": "npx firebase-tools emulators:start --import=./firebase-emulator-data",
    "setup:dev-premium": "npm --prefix functions run setup:dev-premium",
    "deploy:staging": "npx firebase-tools deploy -P staging",
    "deploy:prod": "npx firebase-tools deploy -P production",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:functions": "npm --prefix functions run build && npx firebase-tools deploy --only functions"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
