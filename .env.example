# Flow Routine App - Variáveis de Ambiente Opcionais

# Google OAuth 2.0 Client ID (Opcional - Criado no Google Cloud Console)
# Para configurar seu próprio Client ID OAuth 2.0:
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Crie uma credencial: "ID do cliente OAuth" -> "Aplicativo da Web"
# 3. Adicione em "Origens JavaScript autorizadas": http://localhost:3000
# 4. Adicione em "URIs de redirecionamento autorizados": http://localhost:3000
# 5. Cole o Client ID gerado abaixo:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Config (Opcional - Sincronização em Nuvem Produção)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase Emulator (Testes Locais sem consumo de quota ou custos)
# Defina como "true" para conectar o frontend aos emuladores locais (Auth: 9099, Firestore: 8080, Functions: 5001)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# AI Proxy Cloud Function (Opcional - sobrescreve a URL do proxy de IA)
# Padrão local quando emulador ativo: http://127.0.0.1:5001/{projectId}/southamerica-east1/aiProxy
# NEXT_PUBLIC_AI_PROXY_URL=http://127.0.0.1:5001/flow-app-dev/southamerica-east1/aiProxy

